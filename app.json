{
  "expo": {
    "name": "ON TRACK",
    "slug": "on-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.acassiusd.ontrack",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.acassiusd.ontrack"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "ontrack",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose private progress photos for ON TRACK.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-notifications",
      "expo-secure-store",
      [
        "./plugins/with-on-track-iphone",
        {
          "groupIdentifier": "group.com.acassiusd.ontrack"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.acassiusd.ontrack",
          "widgets": [
            {
              "name": "OnTrackProgress",
              "displayName": "ON TRACK",
              "description": "Calories, weight trend, and daily checks",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      "expo-apple-authentication"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.acassiusd.ontrack.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.acassiusd.ontrack"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "60c3be58-1725-43ca-8c51-e274a745b03f"
      }
    },
    "owner": "devcassius",
    "updates": {
      "url": "https://u.expo.dev/60c3be58-1725-43ca-8c51-e274a745b03f",
      "checkAutomatically": "ON_LOAD"
    }
  }
}
