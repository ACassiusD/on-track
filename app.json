{
  "expo": {
    "name": "ON TRACK",
    "slug": "on-track",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.acassiusd.ontrack"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.acassiusd.ontrack"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "ontrack",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose private progress photos for ON TRACK.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-notifications",
      "expo-secure-store",
      [
        "./plugins/with-on-track-iphone",
        {
          "groupIdentifier": "group.com.acassiusd.ontrack"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.acassiusd.ontrack",
          "widgets": [
            {
              "name": "OnTrackProgress",
              "displayName": "ON TRACK",
              "description": "Calories, weight trend, and daily checks",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ]
    ]
  }
}
